root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{cs,csproj,props,json}]
indent_size = 4

[*.json]
indent_size = 2

[*.{ts,tsx,css,html,yml,yaml}]
indent_size = 2

# Test names read as sentences with underscores.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
