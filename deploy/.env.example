# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Generate random values with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Free DuckDNS name pointing to the VM's static address.
API_DOMAIN=rolehound-api.duckdns.org
POSTGRES_PASSWORD=

# Shared with the Cloudflare Pages proxy (PROXY_SECRET there). Caddy refuses
# requests without it, except the Telegram webhook and the health checks.
PROXY_SECRET=

# Public address of the web app (Cloudflare Pages): links in emails and CORS.
Web__BaseUrl=https://rolehound.pages.dev

# First admin, created once when the database has no users; receives an access link.
Admin__Email=
Admin__Username=

# Key for the scheduled task endpoints (at least 32 characters).
Tasks__Key=

# Certificate that wraps the Data Protection keys (base64 PFX), see README.
DataProtection__CertificateBase64=
DataProtection__CertificatePassword=

# Gmail SMTP with an app password (2-Step Verification must be on). Port 587, STARTTLS.
Email__From=
Email__FromName=rolehound
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=

# Optional: GitHub token raises the API limit from 60 to 5,000 requests per hour.
Collection__GitHubToken=

# Optional: Telegram bot from @BotFather.
Telegram__BotToken=
Telegram__BotUsername=
Telegram__WebhookSecret=
Telegram__WebhookUrl=https://rolehound-api.duckdns.org/telegram/webhook

# Commit SHA of the API image to run (CI publishes one per commit on main).
API_TAG=
